# ===== Supabase（仅服务端使用，严禁添加 NEXT_PUBLIC_ 前缀） =====
SUPABASE_URL=https://your-project.supabase.co
# 新项目优先使用 sb_secret_...；旧项目也可填写 service_role JWT
SUPABASE_SECRET_KEY=sb_secret_xxx
# SUPABASE_SERVICE_ROLE_KEY=

# 部署后的正式域名，用于链接分享预览图
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# 定时释放过期号码接口密钥（至少 16 位随机字符串）
CLEANUP_SECRET=replace_with_a_long_random_secret

# ===== Grizzly SMS（仅服务端使用） =====
GRIZZLY_API_KEY=在此填写个人中心的API密钥
GRIZZLY_API_BASE=https://api.grizzlysms.com/stubs/handler_api.php
# Grizzly 官方国家表：香港 = 14
GRIZZLY_COUNTRY_ID=14
# 留空时系统通过 getServicesList 自动查找 SoulAPP；自动识别失败时再填写
GRIZZLY_SERVICE_CODE=
GRIZZLY_MAX_PRICE=

# SoulAPP 香港号码的换号等待和最长保留时间（秒）
GRIZZLY_SWAP_WAIT_SECONDS=600
GRIZZLY_ORDER_TTL_SECONDS=600
